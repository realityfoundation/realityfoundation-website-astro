---
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/consts";
import Annotation from "@/components/Annotation.astro";
import RoadmapTimeline from "@/components/RoadmapTimeline.astro";
---

<Layout title={SITE.TITLE} description={SITE.DESCRIPTION}>
    <div class="container mx-auto px-6 pt-18">
        <div class="space-y-20 py-12">
            <!-- Mission Section -->
            <section class="space-y-6">
                <h1 class="heading text-4xl md:text-6xl uppercase">Our mission</h1>
                <div class="space-y-4">
                    <p class="text-lg leading-relaxed text-secondary">
                        RealityFoundation is a tech nonprofit based in Tallinn, Estonia and operating across all of Europe. 
                        Our mission is to build the infrastructure to certify and verify the origin of digital content. 
                        As AI makes it effortless to produce convincing images, video, and documents, knowing what is 
                        real has become one of the defining challenges of our era. 
                        We are creating an open and trusted layer for digital media — one that allows anyone to establish 
                        and verify where content comes from. 
                        We are at once a technology organization and a public initiative, 
                        working to ensure that the systems societies depend on, from journalism and justice to commerce and 
                        public debate, can continue to rest on a shared understanding of what is real.
                    </p>
                    <p class="text-lg leading-relaxed text-secondary">
                        We believe that trust in what we see is a public good. 
                        As AI blurs the line between the authentic and the fabricated, that trust cannot hold without a 
                        dependable layer of ground truth beneath our shared reality. RealityFoundation exists to build and protect it.
                    </p>
                </div>
            </section>

            <section class="space-y-6 border-t border-secondary pt-12">
                <div class="flex flex-col gap-8 md:flex-row md:items-center">
                    <a href="https://www.eit.europa.eu/" target="_blank" rel="noopener noreferrer" class="w-fit flex-shrink-0 rounded-lg bg-white p-6 transition hover:opacity-90">
                        <picture>
                            <source srcset="/eu_cofounded_white.png" media="(prefers-color-scheme: dark)" />
                            <img src="/eu_cofounded_blue.png" alt="Co-funded by the European Union" class="h-10 w-auto md:h-12" loading="lazy" decoding="async" />
                        </picture>
                    </a>
                    <div class="space-y-4">
                        <h2 class="heading text-3xl uppercase md:text-4xl">Supported by the EIT</h2>
                        <p class="text-lg leading-relaxed text-secondary">
                            Support from the European Institute of Innovation & Technology (EIT) helps RealityFoundation build open, trustworthy infrastructure for digital media and strengthen the public foundations of what we can trust online.
                        </p>
                        <a href="https://www.eit.europa.eu/" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary uppercase hover:underline">Learn more about the EIT →</a>
                    </div>
                </div>
            </section>

            <!-- Team Section -->
            <section class="space-y-8 border-t border-secondary pt-12">
                <h2 class="heading text-4xl uppercase">Our team</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
                    <div class="space-y-3 border border-secondary p-6 rounded-lg h-full flex flex-col">
                        <Annotation
                            src="/avatar_emilio.jpg"
                            alt="Portrait of Emilio Dalla Torre"
                            label="AI-generated"
                            variant="AI"
                            side="right"
                        />
                        <h3 class="heading text-xl uppercase">Emilio Dalla Torre</h3>
                        <p class="text-sm text-primary font-semibold uppercase">
                            Co-founder & Chief Executive Officer
                        </p>
                        <p class="text-sm leading-relaxed text-secondary">
                            Emilio holds a background in Engineering Physics and is completing a
                            Double Degree Master in HPC Engineering and ICT Innovation at Politecnico
                            di Milano and KTH Royal Institute of Technology. He has worked across
                            full-stack engineering, AI systems, and large-scale infrastructure at 
                            Accenture and Qualcomm. He leads RealityFoundation's product management and 
                            systems architecture.
                        </p>
                    </div>
                    <div class="space-y-3 border border-secondary p-6 rounded-lg h-full flex flex-col">
                        <Annotation
                            src="/avatar_bianca.jpg"
                            alt="Portrait of Bianca Illing"
                            label={"Captured by\nFujiFilm X-T30"}
                            variant="captured"
                            side="right"
                        />
                        <h3 class="heading text-xl uppercase">Bianca Illing</h3>
                        <p class="text-sm text-primary font-semibold uppercase">
                            Co-founder & Chief Growth Officer
                        </p>
                        <p class="text-sm leading-relaxed text-secondary">
                            Bianca holds an MSc in Economics from Nova SBE and a BSc in Business
                            Administration from ESCP. She has worked in strategy consulting and is
                            currently Founder's Associate at greenmetrics.ai, where she focuses on AI
                            applications for climate resilience. She leads RealityFoundation's GTM strategy 
                            and commercial partnerships.
                        </p>
                    </div>
                    <div class="space-y-3 border border-secondary p-6 rounded-lg h-full flex flex-col">
                        <Annotation
                            src="/avatar_gaia.jpg"
                            alt="Portrait of Gaia Dalla Zonca"
                            label="AI-generated"
                            variant="AI"
                            side="left"
                        />
                        <h3 class="heading text-xl uppercase">Gaia Dalla Zonca</h3>
                        <p class="text-sm text-primary font-semibold uppercase">
                            Co-founder & Head of Regulatory Affairs
                        </p>
                        <p class="text-sm leading-relaxed text-secondary">
                            Gaia holds a CEMS Master in International Management from Nova SBE and
                            FGV-EAESP, and a Bachelor in International Politics and Government from
                            Bocconi University. She currently works at EY. She leads RealityFoundation's
                            operations, governance, and institutional relationships.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Scientific Committee Section -->
            <!--section class="space-y-6 border-t border-secondary pt-12">
                <h2 class="heading text-4xl uppercase">Scientific committee</h2>
                <div class="max-w-3xl space-y-4">
                    <p class="text-lg leading-relaxed text-secondary">
                        RealityFoundation is governed by an independent Scientific Committee
                        responsible for ensuring the rigour, integrity, and independence of our
                        research output. The committee is currently being formed. We are in conversation
                        with researchers and academics specialising in computer vision, AI ethics,
                        digital forensics, and media law.
                    </p>
                    <p class="text-sm italic text-secondary">Announcements forthcoming.</p>
                </div>
            </section-->

            <!-- Research Roadmap Section -->
            <section class="space-y-8 border-t border-secondary pt-12">
                <h2 class="heading text-4xl uppercase">Execution Roadmap</h2>
                <RoadmapTimeline />
            </section>
        </div>
    </div>
</Layout>
